# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_TEST_URL=postgresql://user:password@host/dbname_test?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Flight Data (AirLabs primary, Kiwi fallback)
AIRLABS_API_KEY=
KIWI_API_KEY=

# AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@yourdomain.com

# Cron Security
CRON_SECRET=your-cron-secret-here
