# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_TEST_URL=postgresql://user:password@host/dbname_test?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Flight Data (Kiwi primary → VietJet → Google → AirLabs fallback)
KIWI_API_KEY=
AIRLABS_API_KEY=

# Flights worker (unified service — VietJet + Google on Railway).
# Deploy services/flights-worker/ to Railway, then set:
FLIGHTS_SERVICE_URL=http://localhost:3000
FLIGHTS_SERVICE_SECRET=change-me

# VietJetAir static token (optional fallback if token service is not running)
# Obtain by running: npm run vietjet:token
# Expires after ~6 hours and must be rotated manually.
VIETJET_WAF_TOKEN=
VIETJET_DEVICE_ID=

# AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@yourdomain.com

# MCP Server (used by external AI agents calling /api/mcp)
SKYFRAME_MCP_API_KEY=change-me
